# =============================================================================
# Published image: XFCE + TigerVNC + noVNC, plus Anthropic's official Claude
# Desktop for Linux installed from its .deb (pinned in claude-desktop.pin).
# Multi-arch (linux/amd64, linux/arm64): the install script picks the .deb
# matching the target architecture, so there is nothing to cross-compile.
# =============================================================================
FROM ubuntu:22.04

ARG NODE_VERSION=22.x

ENV USER=root
ENV HOME=/root
ENV DEBIAN_FRONTEND=noninteractive

# Node.js is not needed by Claude Desktop itself (it bundles its own runtime),
# but most MCP servers users add are launched with npx/node.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg lsb-release apt-transport-https && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION} | bash - && \
    apt-get install -y --no-install-recommends \
        nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Desktop environment + VNC stack.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xfce4 \
        xfce4-terminal \
        mousepad \
        tigervnc-standalone-server \
        tigervnc-common \
        tigervnc-tools \
        novnc \
        websockify \
        net-tools \
        netcat-openbsd \
        git \
        python3-pip \
        xfonts-base \
        xfonts-75dpi \
        xfonts-100dpi \
        xauth \
        dbus \
        dbus-x11 \
        at-spi2-core \
        libglib2.0-bin \
        autocutsel \
        xclip \
        wmctrl \
        openbox \
        nano \
        vim \
        xdg-utils \
        desktop-file-utils \
        x11-xserver-utils \
        x11-utils \
        scrot \
        libnspr4 \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libgtk-3-0 \
        libgbm1 \
        libasound2 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Git MCP server, referenced by the default claude_desktop_config.json
# (python -m mcp_server_git). Without it every fresh container has a broken
# MCP entry that costs users 30+ min to diagnose.
RUN pip3 install --no-cache-dir mcp-server-git

# Replace Ubuntu 22.04's noVNC 1.0.0 with upstream v1.6.0. The apt package is
# pre-Async-Clipboard-API, so browser Ctrl+C/V cannot push text into the VNC
# session — only the manual sidebar Clipboard panel works. v1.5+ integrates
# the browser's Async Clipboard API, making Ctrl+V transparent on localhost
# (browser asks for clipboard permission once). websockify ships separately,
# so removing the directory contents is safe.
RUN rm -rf /usr/share/novnc && \
    mkdir -p /usr/share/novnc && \
    curl -fsSL https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz | \
        tar -xz -C /usr/share/novnc --strip-components=1

# Setup directories. Password file is written at runtime by startup.sh.
RUN mkdir -p /root/.vnc /scripts/utils /scripts/run /scripts/build /scripts/fix /dockerhub/logs && \
    touch /root/.Xauthority && chmod 600 /root/.Xauthority

# VNC config + xstartup + main scripts (small; no need to multistage).
COPY scripts/utils/xstartup /scripts/utils/xstartup
COPY scripts/utils/xstartup /root/.vnc/xstartup
COPY scripts/utils/config /root/.vnc/config
COPY scripts/run/startup.sh /startup.sh
COPY scripts /scripts/
RUN chmod +x /root/.vnc/xstartup /scripts/utils/xstartup /startup.sh && \
    chmod 644 /root/.vnc/config && \
    chmod +x /scripts/utils/*.sh /scripts/run/*.sh /scripts/build/*.sh /scripts/fix/*.sh && \
    ln -sf /scripts/utils/xstartup /scripts/xstartup && \
    ln -sf /scripts/utils/config /scripts/config && \
    ln -sf /scripts/utils/verify-dependencies.sh /scripts/verify-dependencies.sh

# Claude Desktop itself: official .deb, version + per-arch SHA256 pinned in
# claude-desktop.pin. Kept last so a version bump rebuilds only this layer.
COPY claude-desktop.pin /tmp/claude-desktop.pin
RUN /scripts/build/install-claude-desktop.sh /tmp/claude-desktop.pin && \
    /scripts/utils/desktop-integration.sh && \
    rm -f /tmp/claude-desktop.pin

WORKDIR /root
EXPOSE 5901 6080

# Healthcheck verifies VNC is up AND the Claude main process is alive (so a
# crashed app surfaces as unhealthy instead of green-on-port-only).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD nc -z localhost 5901 && pgrep -f '^/usr/(bin|lib/claude-desktop)/claude-desktop' >/dev/null || exit 1

CMD ["/startup.sh"]
